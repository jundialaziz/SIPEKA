APP_NAME="IoT Fire Alarm Backend"
APP_ENV=local
APP_KEY=base64:7K5j/oUjWvB4d8uB5oF8xZ8nZ6yYq3cK3vW8pA1dE4M=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE CONFIGURATION
# Default: MySQL (XAMPP / Laragon). Jika menggunakan SQLite, ganti DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iot_fire_alarm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# CORS CONFIGURATION
# Boleh menggunakan '*' untuk semua origin, atau spesifikkan domain frontend Anda
CORS_ALLOWED_ORIGINS=*

# TELEGRAM BOT ALERT CONFIGURATION
# Dapatkan bot token dari @BotFather dan chat ID dari @userinfobot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
